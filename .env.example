# Backstop operator configuration. Copy to .env (`cp .env.example .env`) and fill in only the steps you need.
# .env is gitignored. NEVER commit it, never paste its secrets in chat.
# Everything runs on MAINNET with tiny amounts (NEAR Intents has no testnet).
#
# All example values below are FAKE. Users never put a key here: an owner signs every owner action in
# their own NEAR wallet. Variables from Backstop v1 (OWNER_PRIVATE_KEY, POLICY_CONTRACT_PRIVATE_KEY) make
# the agent refuse to start: delete them. OWNER_ACCOUNT_ID, DERIVATION_PATH, NEAR_NETWORK are ignored.
#
# WHAT DO I NEED?
#   Try it without keys .......... Step 1 only      -> pnpm demo --dry-run
#   Run the agent for real ....... Steps 1 + 2      -> pnpm demo
#   Create a policy for a user ... Step 3           -> pnpm --filter @backstop/scripts deploy-policy ...
#   Run the website .............. Step 4 (all optional)
# Steps 5 and 6 are optional extras.

# ============================================================================
# STEP 1 - The policy the agent watches (needed for the agent, even in a dry run)
# ============================================================================
# The NEAR account of a deployed policy contract. You get it from Step 3 (the deploy-policy script prints it).
# One policy protects one loan on one chain (Base or Arbitrum); the agent reads the chain from the policy.
# Example: POLICY_CONTRACT_ID=alice.backstop.near
POLICY_CONTRACT_ID=

# ============================================================================
# STEP 2 - The agent's key (needed only for live runs, NOT for --dry-run)
# ============================================================================
# The operator's own NEAR account, the one that runs the agent. The policy's owner calls set_agent so the
# policy accepts this account.
# Example: AGENT_ACCOUNT_ID=backstop-agent.near
AGENT_ACCOUNT_ID=
# A function-call access key ON that account (ed25519:...), restricted to the policy:
#   receiver = POLICY_CONTRACT_ID, methods = rescue,fund_bridge,approve_pool.
# It cannot attach deposits, so it cannot call any owner method. This is the only secret on the agent host.
# Create it with:  near account add-key backstop-agent.near grant-function-call-access --receiver-account-id <POLICY_CONTRACT_ID> --method-names 'rescue,fund_bridge,approve_pool' --allowance '1 NEAR' autogenerate-new-keypair print-to-terminal ...
# Bot service (`pnpm --filter @backstop/agent start`, many vaults): instead use a DEDICATED bot account
# holding at most ~2 NEAR, set as the factory's default_agent, and put its FULL-ACCESS key here from the
# host's secret store. Each vault accepts only rescue, fund_bridge and approve_pool from it, within that
# vault's limits; the bot account's own NEAR is the extra exposure.
# Example: AGENT_PRIVATE_KEY=ed25519:3sKq...fakefakefake...9xQz
AGENT_PRIVATE_KEY=
# Bot service only: extra operator-made vaults to watch besides the factory's (comma-separated).
# Example: POLICY_CONTRACT_IDS=alice.backstop.near,bob.backstop.near
POLICY_CONTRACT_IDS=
# Bot service only (optional): operator alerts (rescue done/failed, vault refused, bot NEAR low, RPC failing).
# A Discord or Slack-style incoming webhook (https). Alerts never contain keys.
ALERT_WEBHOOK_URL=
# Bot service only (optional): dead-man's switch URL fetched once per pass (e.g. healthchecks.io).
HEARTBEAT_URL=

# ============================================================================
# STEP 3 - Creating policies (needed only on the machine where YOU run deploy-policy; never on the agent host)
# ============================================================================
# A funded NEAR account (about 3.1 NEAR per policy, mostly refunded on close) that creates keyless policy
# accounts as sub-accounts of itself: <name>.<DEPLOYER_ACCOUNT_ID>. It gets no rights over a policy afterwards.
# Example: DEPLOYER_ACCOUNT_ID=backstop.near
DEPLOYER_ACCOUNT_ID=
# Full-access key of that account.
# Example: DEPLOYER_PRIVATE_KEY=ed25519:5Hq...fakefakefake...2LmP
DEPLOYER_PRIVATE_KEY=
# Your service fee paid in NEAR USDC in the same transaction that pays 1Click, only
# when a rescue has to bridge money. Fixed per policy when it is created.
#   FEE_ACCOUNT_ID: a NEAR account YOU control (name.near, or a 64-hex implicit account from any NEAR wallet).
#     Not an exchange deposit address. Leave empty for no fee.
#   FEE_BPS: 10 = 0.10%. The contract refuses anything above 50 (0.50%).
# Example: FEE_ACCOUNT_ID=treasury.near
FEE_ACCOUNT_ID=
FEE_BPS=10
# Self-serve vault factory (optional). `pnpm factory:build`, then
#   pnpm --filter @backstop/scripts deploy-factory [--name vaults] [--send]
# prints the exact NEAR needed (~4.9 NEAR, locked for good: the factory is keyless) and these three lines.
# Example: FACTORY_CONTRACT_ID=vaults.backstop.near
FACTORY_CONTRACT_ID=

# ============================================================================
# STEP 4 - Website (all optional; public values only, the web server reads no private key)
# ============================================================================
# In production set these on the web host explicitly; do not give it this file.
# Example: NEXT_PUBLIC_SITE_URL=https://backstop.finance
NEXT_PUBLIC_SITE_URL=
# Link for the "GitHub" nav item. Example: NEXT_PUBLIC_REPO_URL=https://github.com/your-org/backstop
NEXT_PUBLIC_REPO_URL=
# Pre-fills the dashboard / connect flow. Examples: alice.backstop.near / backstop-agent.near / factory.backstop.near
NEXT_PUBLIC_POLICY_CONTRACT_ID=
NEXT_PUBLIC_AGENT_ACCOUNT_ID=
NEXT_PUBLIC_FACTORY_ID=
# sha256 (64 lowercase hex) of the policy wasm the factory embeds = factory.policy_code_hash(); deploy-factory prints it.
NEXT_PUBLIC_POLICY_CODE_HASH=
# WalletConnect / Reown project id (https://dashboard.reown.com). Without it WalletConnect is hidden.
# Example: NEXT_PUBLIC_WC_PROJECT_ID=0123456789abcdef0123456789abcdef
NEXT_PUBLIC_WC_PROJECT_ID=

# ============================================================================
# STEP 5 - RPC endpoints (optional; public ones are built in and used when these are empty)
# ============================================================================
# Comma-separated https URLs, tried BEFORE the built-in lists. Use a keyed endpoint if public ones rate-limit you.
# Example: NEAR_RPC_URL=https://rpc.mainnet.fastnear.com,https://near.drpc.org
NEAR_RPC_URL=
# Loan chains: the agent uses the one matching the policy's chain. Fill in only the chain(s) you protect.
# Example: BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=
# Verified 2026-11-14 (eth_chainId = 0xa4b1 = 42161); the first is Arbitrum's own public endpoint
# (docs.arbitrum.io/for-devs/dev-tools-and-resources/chain-info, no uptime/rate-limit guarantee).
# Public, no key: https://arb1.arbitrum.io/rpc, https://arbitrum-one-rpc.publicnode.com, https://arbitrum.drpc.org
# Not usable keyless: rpc.ankr.com/arbitrum (needs a key), arbitrum.llamarpc.com (no answer).
# Keyed example: ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc,https://arbitrum-one-rpc.publicnode.com,https://arbitrum.drpc.org

# ============================================================================
# STEP 6 - Extras (all optional)
# ============================================================================
# NEAR Intents 1Click partner JWT (https://partners.near-intents.org). Without it 1Click adds a 0.25% fee.
ONE_CLICK_JWT=
# NEAR AI Cloud key (https://cloud.near.ai) for the human-readable rescue receipt. Rescues never wait on it:
# if missing, a template receipt is used. List models with GET https://cloud-api.near.ai/v1/models
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
# Where rescue history is stored. Empty = rescues.json at the repo root. Or a Postgres URL (e.g. Neon):
# Example: DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/backstop?sslmode=require
DATABASE_URL=
# RESCUES_FILE=./rescues.json
# The bot service REQUIRES DATABASE_URL in production: the web reads vault_status rows from the same database.
# Without it, status rows go to a local JSON file (VAULT_STATUS_FILE, default ./vault-status.json).
# VAULT_STATUS_FILE=./vault-status.json
